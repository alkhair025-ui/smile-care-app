import React, { useCallback, useEffect, useState } from 'react';
import { View, Text, StyleSheet, ScrollView, ActivityIndicator, I18nManager } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { useLocalSearchParams } from 'expo-router';

// نفس متغير الـ API الأساسي المستخدم بباقي التطبيق (src/api.ts) — شامل "/api" بآخره أصلاً
import { API_BASE_URL } from '@/src/api';

type PortalData = {
  clinic: { name: string; phone: string; address: string; slug: string };
  patient: { full_name: string; medical_history: string; allergies: string; medications: string; doctor_notes: string };
  chart: { tooth: number; condition: string; note: string }[];
  treatment_types: { key: string; label: string; color: string }[];
  invoices: { id: string; date: string; items: any[]; total: number; paid: number; currency: string }[];
  financials: { total_billed: number; total_paid: number; remaining: number };
};

const CONDITION_LABELS: Record<string, string> = {
  healthy: 'سليم',
  caries: 'تسوس',
  filling: 'حشوة',
  crown: 'تاج',
  extracted: 'مقلوع',
};

function money(amount: number, currency: string) {
  return `${(amount || 0).toLocaleString('en-US')} ${currency || 'SYP'}`;
}

export default function PatientPortal() {
  const { token } = useLocalSearchParams<{ token: string }>();
  const [data, setData] = useState<PortalData | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  const load = useCallback(async () => {
    if (!token) return;
    setLoading(true);
    setError('');
    try {
      const res = await fetch(`${API_BASE_URL}/public/patient/${token}`);
      if (!res.ok) {
        if (res.status === 404) throw new Error('الرابط غير صالح أو منتهي الصلاحية');
        throw new Error('تعذّر تحميل البيانات، حاول مجدداً');
      }
      const json = await res.json();
      setData(json);
    } catch (e: any) {
      setError(e?.message || 'حدث خطأ غير متوقع');
    } finally {
      setLoading(false);
    }
  }, [token]);

  useEffect(() => {
    load();
  }, [load]);

  if (loading) {
    return (
      <SafeAreaView style={styles.center}>
        <ActivityIndicator size="large" color="#4A7065" />
      </SafeAreaView>
    );
  }

  if (error || !data) {
    return (
      <SafeAreaView style={styles.center}>
        <Text style={styles.errorText}>{error || 'تعذّر تحميل البيانات'}</Text>
      </SafeAreaView>
    );
  }

  const { clinic, patient, chart, invoices, financials } = data;

  return (
    <SafeAreaView style={styles.root}>
      <ScrollView contentContainerStyle={styles.content}>
        {/* Clinic header */}
        <View style={styles.headerCard}>
          <Text style={styles.clinicName}>{clinic?.name || 'العيادة'}</Text>
          {clinic?.address ? <Text style={styles.clinicSub}>{clinic.address}</Text> : null}
          {clinic?.phone ? <Text style={styles.clinicSub}>{clinic.phone}</Text> : null}
        </View>

        {/* Patient name */}
        <Text style={styles.patientName}>مرحباً {patient?.full_name || ''} 🦷</Text>

        {/* Medical info */}
        <View style={styles.card}>
          <Text style={styles.cardTitle}>المعلومات الطبية</Text>
          <Row label="التاريخ المرضي" value={patient?.medical_history} />
          <Row label="الحساسية" value={patient?.allergies} />
          <Row label="الأدوية" value={patient?.medications} />
          {patient?.doctor_notes ? <Row label="ملاحظات الطبيب" value={patient.doctor_notes} /> : null}
        </View>

        {/* Dental chart summary */}
        <View style={styles.card}>
          <Text style={styles.cardTitle}>مخطط الأسنان</Text>
          {chart.length === 0 ? (
            <Text style={styles.emptyText}>لا توجد بيانات مسجّلة على المخطط</Text>
          ) : (
            chart
              .filter((c) => c.condition !== 'healthy')
              .map((c) => (
                <View key={c.tooth} style={styles.chartRow}>
                  <Text style={styles.chartTooth}>سن {c.tooth}</Text>
                  <Text style={styles.chartCond}>{CONDITION_LABELS[c.condition] || c.condition}</Text>
                </View>
              ))
          )}
        </View>

        {/* Financial summary */}
        <View style={styles.card}>
          <Text style={styles.cardTitle}>الحالة المالية</Text>
          <Row label="إجمالي الفواتير" value={money(financials.total_billed, invoices[0]?.currency || 'SYP')} />
          <Row label="المدفوع" value={money(financials.total_paid, invoices[0]?.currency || 'SYP')} />
          <Row label="المتبقي" value={money(financials.remaining, invoices[0]?.currency || 'SYP')} highlight />
        </View>

        {/* Invoices */}
        <View style={styles.card}>
          <Text style={styles.cardTitle}>الفواتير</Text>
          {invoices.length === 0 ? (
            <Text style={styles.emptyText}>لا توجد فواتير</Text>
          ) : (
            invoices.map((inv) => (
              <View key={inv.id} style={styles.invoiceCard}>
                <View style={styles.invoiceHead}>
                  <Text style={styles.invoiceDate}>{(inv.date || '').slice(0, 10)}</Text>
                  <Text style={styles.invoiceTotal}>{money(inv.total, inv.currency)}</Text>
                </View>
                {(inv.items || []).map((it: any, idx: number) => (
                  <Text key={idx} style={styles.invoiceItem}>
                    • {it.description} ({it.quantity} × {it.unit_price})
                  </Text>
                ))}
              </View>
            ))
          )}
        </View>
      </ScrollView>
    </SafeAreaView>
  );
}

function Row({ label, value, highlight }: { label: string; value?: string | number; highlight?: boolean }) {
  return (
    <View style={styles.row}>
      <Text style={styles.rowLabel}>{label}</Text>
      <Text style={[styles.rowValue, highlight && styles.rowValueHighlight]}>{value || '—'}</Text>
    </View>
  );
}

const styles = StyleSheet.create({
  root: { flex: 1, backgroundColor: '#F4F6F5' },
  center: { flex: 1, alignItems: 'center', justifyContent: 'center', backgroundColor: '#F4F6F5' },
  content: { padding: 16, paddingBottom: 48 },
  errorText: { color: '#B3261E', fontSize: 16, textAlign: 'center', writingDirection: 'rtl', paddingHorizontal: 24 },
  headerCard: { backgroundColor: '#4A7065', borderRadius: 14, padding: 20, marginBottom: 16, alignItems: 'center' },
  clinicName: { color: '#fff', fontSize: 20, fontWeight: 'bold', textAlign: 'center', writingDirection: 'rtl' },
  clinicSub: { color: '#E1E8E6', fontSize: 13, marginTop: 4, textAlign: 'center', writingDirection: 'rtl' },
  patientName: { fontSize: 18, fontWeight: 'bold', color: '#1A211E', textAlign: 'right', writingDirection: 'rtl', marginBottom: 16 },
  card: { backgroundColor: '#fff', borderRadius: 14, padding: 16, marginBottom: 16 },
  cardTitle: { fontSize: 16, fontWeight: 'bold', color: '#1A211E', textAlign: 'right', writingDirection: 'rtl', marginBottom: 10 },
  row: { flexDirection: 'row-reverse', justifyContent: 'space-between', paddingVertical: 8, borderBottomWidth: 1, borderBottomColor: '#E1E8E6' },
  rowLabel: { color: '#6B7876', textAlign: 'right', writingDirection: 'rtl' },
  rowValue: { color: '#1A211E', fontWeight: '500', textAlign: 'right', writingDirection: 'rtl', flex: 1, marginLeft: 12 },
  rowValueHighlight: { color: '#4A7065', fontWeight: 'bold' },
  emptyText: { color: '#6B7876', textAlign: 'center', paddingVertical: 12 },
  chartRow: { flexDirection: 'row-reverse', justifyContent: 'space-between', paddingVertical: 6, borderBottomWidth: 1, borderBottomColor: '#E1E8E6' },
  chartTooth: { color: '#1A211E', fontWeight: 'bold', textAlign: 'right', writingDirection: 'rtl' },
  chartCond: { color: '#4A7065', textAlign: 'right', writingDirection: 'rtl' },
  invoiceCard: { backgroundColor: '#F4F6F5', borderRadius: 10, padding: 12, marginBottom: 8 },
  invoiceHead: { flexDirection: 'row-reverse', justifyContent: 'space-between', marginBottom: 6 },
  invoiceDate: { color: '#1A211E', writingDirection: 'rtl' },
  invoiceTotal: { color: '#4A7065', fontWeight: 'bold', writingDirection: 'rtl' },
  invoiceItem: { color: '#6B7876', fontSize: 13, textAlign: 'right', writingDirection: 'rtl' },
});
